{
    "name": "playwright-component-framework",
    "version": "1.0.0",
    "description": "Reusable, component-driven Playwright UI testing framework",
    "main": "index.js",
    "scripts": {
        "test": "playwright test",
        "test:ui": "playwright test --ui",
        "test:headed": "playwright test --headed",
        "lint": "eslint . --ext .ts",
        "lint:fix": "eslint . --ext .ts --fix",
        "format": "prettier --write \"**/*.{ts,js,json,md}\""
    },
    "keywords": [
        "playwright",
        "testing",
        "ui",
        "automation",
        "component",
        "pom"
    ],
    "author": "Your Name",
    "license": "MIT",
    "devDependencies": {
        "@playwright/test": "^1.48.0",
        "@types/node": "^22.0.0",
        "typescript": "^5.5.0",
        "eslint": "^8.57.0",
        "prettier": "^3.3.0",
        "@typescript-eslint/eslint-plugin": "^7.0.0",
        "@typescript-eslint/parser": "^7.0.0",
        "eslint-config-prettier": "^9.1.0",
        "eslint-plugin-playwright": "^1.6.0"
    }
}